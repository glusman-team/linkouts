<Layouts.app flash={@flash}>
  <section class="space-y-6">
    <header class="space-y-3">
      <h1 class="text-3xl font-bold">Knowledge graphs</h1>
      <p class="opacity-80">
        Human-readable pages for the relationships stored from each knowledge graph, with
        the evidence behind every claim and a downloadable copy of the stored data.
      </p>
      <p>
        <a class="btn btn-primary" href={~p"/random"}>show me a random relationship</a>
      </p>
    </header>

    <ul class="space-y-4">
      <li :for={kg <- @kgs} class="card space-y-2 bg-base-200 p-4">
        <h2 class="text-lg font-semibold">
          <%= if kg.url do %>
            <a class="link link-hover" href={kg.url}>{kg.display_name}</a>
          <% else %>
            {kg.display_name}
          <% end %>
        </h2>
        <p class="text-sm whitespace-pre-line opacity-90">{kg.description}</p>
      </li>
    </ul>
  </section>
</Layouts.app>
