<Layouts.app flash={@flash} kg_slug={@kg_slug}>
  <%= case @view do %>
    <% :ok -> %>
      <article class="edge-page">
        <header class="edge-head">
          <p class="edge-kicker">
            <%!-- The name is a link into this graph (a random relationship from it), and the
                 source icon beside it is the external documentation it used to be. One link
                 doing both would send a reader who wanted the graph out of this app. --%>
            <a
              :if={@kg_slug}
              class="kg-link"
              href={~p"/#{@kg_slug}/random"}
              title={"A random relationship from #{@kg_name}"}
            >{@kg_name}</a>
            <span :if={!@kg_slug}>{@kg_name}</span>
            <a
              :if={@config && @config.url}
              class="ext-link"
              href={@config.url}
              target="_blank"
              rel="noopener noreferrer"
              title="The knowledge source's documentation"
            >
              <.icon name="hero-arrow-top-right-on-square" class="ext-icon" /><span class="sr-only">
                (opens the knowledge source's documentation in a new tab)
              </span>
            </a>
            <span class="version-pill" title={@key}>version {@version_label}</span>
            <span :if={@latest} class="latest-badge">latest</span>
          </p>

          <%= if @sentence do %>
            <h1 class="edge-sentence">
              <EdgeComponents.segments segments={@sentence} />
            </h1>
          <% else %>
            <h1 class="edge-sentence">Edge {@edge_id}</h1>
            <EdgeComponents.raw_doc doc={@doc} />
          <% end %>

          <p class="edge-idline">
            <code id="edge-id">{@edge_id}</code>
            <button
              type="button"
              class="copy-btn"
              data-copy={@edge_id}
              aria-label={"Copy the edge id #{@edge_id}"}
            >
              <.icon name="hero-clipboard" class="size-3.5" />
              <span class="copy-text">Copy id</span>
            </button>
            <a class="btn-link" href={~p"/edges/#{@edge_id}/download?version=#{@key}"}>
              <.icon name="hero-document-arrow-down" class="size-4" /> Download KGX
            </a>
          </p>
        </header>

        <div id="edge-detail" aria-live="polite" class="edge-body">
          <%!-- The claim and its evidence, as on the legacy page: the sentence first, the
               evidence lines directly beneath it, both before anything a reader might have to
               scroll for. --%>
          <div class="edge-claim">
            <%= if @relationship do %>
              <p class="edge-relation">
                <EdgeComponents.segments segments={@relationship} />
              </p>
            <% else %>
              <EdgeComponents.diagram doc={@doc} />
            <% end %>

            <p :if={@evidence != []} class="edge-evidence">
              <EdgeComponents.segments segments={@evidence} />
            </p>
          </div>

          <section aria-label="Stored versions and what changed in each" class="edge-versions">
            <h2 class="section-title">Stored versions</h2>
            <EdgeComponents.version_timeline
              edge_id={@edge_id}
              history={@history}
              current={@key}
              latest_label={@latest_label}
            />
            <EdgeComponents.diff_panel prev_key={@prev_key} key_name={@key} diff={@diff} />
          </section>

          <%= if @config && @config.description do %>
            <section aria-label="About this knowledge graph" class="edge-about">
              <h2 class="section-title">About this knowledge graph</h2>
              <p>{@config.description}</p>
              <%= if @feedback_url do %>
                <p>
                  <a
                    class="ext-link"
                    href={@feedback_url}
                    target="_blank"
                    rel="noopener noreferrer"
                  >Something wrong with this relationship? Open an issue.<.icon
                    name="hero-arrow-top-right-on-square"
                    class="ext-icon"
                  /><span class="sr-only"> (opens GitHub in a new tab)</span></a>
                </p>
              <% end %>
            </section>
          <% end %>
        </div>
      </article>
    <% :rate_limited -> %>
      <section aria-live="polite" class="state-page state-page-warning">
        <p class="state-kicker state-kicker-warning">Rate limited</p>
        <h1 class="state-title">The read budget is spent right now</h1>
        <p class="state-body">
          This read was rate limited because the knowledge graph store is at its request
          budget. The window clears within a second; use the button to retry.
        </p>
        <p class="state-actions">
          <button type="button" class="btn btn-primary" phx-click="retry">Retry</button>
          <a class="btn-link" href={~p"/random"}>Open a random relationship instead</a>
        </p>
      </section>
    <% :store_error -> %>
      <section aria-live="polite" class="state-page state-page-error">
        <p class="state-kicker state-kicker-error">Store unavailable</p>
        <h1 class="state-title">The knowledge graph store did not answer</h1>
        <p class="state-body">
          The store did not answer this read. That is usually temporary; use the button to
          retry.
        </p>
        <p class="state-actions">
          <button type="button" class="btn btn-primary" phx-click="retry">Retry</button>
          <a class="btn-link" href={~p"/random"}>Open a random relationship instead</a>
        </p>
      </section>
    <% {:corrupt, reason} -> %>
      <section aria-live="polite" class="state-page state-page-error">
        <p class="state-kicker state-kicker-error">Corrupt stored document</p>
        <h1 class="state-title">This edge document could not be decoded</h1>
        <p class="state-body">
          A document that will not decode is a data bug a curator needs to see, not a missing
          edge, so the reason is shown exactly as the decoder reported it.
        </p>
        <p class="font-mono text-sm break-all">{reason}</p>
        <p class="state-actions">
          <a class="btn-link" href={~p"/random"}>Open a random relationship instead</a>
        </p>
      </section>
  <% end %>
</Layouts.app>
